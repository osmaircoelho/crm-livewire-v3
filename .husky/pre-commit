#!/usr/bin/env bash
. "$(dirname -- "$0")/_/husky.sh"

set -e

# PHPStan – com cache ativado + só staged se quiser ultra-rápido
echo "🔍 PHPStan (rápido)..."
CHANGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.php$')
if [ -n "$CHANGED" ]; then
    echo "$CHANGED" | xargs ./vendor/bin/phpstan analyse --no-progress || exit 1
else
    echo "Nenhum PHP alterado → pulando PHPStan"
fi

# Testes – modo inteligente
echo "🧪 Testes..."
if [ -z "$SKIP_TESTS" ]; then
    if [ -n "$CHANGED" ]; then
        FILTER=$(echo "$CHANGED" | sed 's/\.php$//' | sed 's|/|\\\\|/g' | tr '\n' '|' | sed 's/|$//')
        php artisan test --parallel --stop-on-failure --filter "/($FILTER)/" || exit 1
    else
        echo "Nenhum PHP → pulando testes"
    fi
else
    echo "⚡ SKIP_TESTS=1 → testes ignorados"
fi

# Pint – rápido com --dirty
echo "✨ Pint..."
STAGED_PHP=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(php|blade\.php)$' || true)
if [ -n "$STAGED_PHP" ]; then
    echo "$STAGED_PHP" | xargs ./vendor/bin/pint --dirty
    echo "$STAGED_PHP" | xargs git add
    echo "Pint concluído ✓"
else
    echo "Nada para formatar ✓"
fi

echo "✅ Commit liberado! 🚀"
exit 0
